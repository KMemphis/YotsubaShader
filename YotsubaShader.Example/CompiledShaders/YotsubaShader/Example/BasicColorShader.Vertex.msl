#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct VS_Input
{
    float2 Position;
    float4 Color;
};

struct FS_Input
{
    float4 Color;
};

struct _24
{
    float4 _m0;
    float4 _m1;
};

struct VS_out
{
    float4 _return_Color [[user(locn8)]];
    float4 gl_Position [[position]];
};

struct VS_in
{
    float2 _input_Position [[attribute(0)]];
    float4 _input_Color [[attribute(1)]];
};

vertex VS_out VS(VS_in in [[stage_in]])
{
    VS_out out = {};
    VS_Input _input = {};
    _input.Position = in._input_Position;
    _input.Color = in._input_Color;
    _24 _output;
    _output._m0 = float4(_input.Position.x, _input.Position.y, 0.0, 1.0);
    _output._m1 = _input.Color;
    _return = VS_Output{ _output._m0, _output._m1 };
    out._return_Color = _return.Color;
    return out;
}

