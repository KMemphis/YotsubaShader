<Project>
  <!--
    APIs a las que se traduce el shader. Las alertas de portabilidad (YS07xx) solo nombran estas.
    Ejemplo en el .csproj: <YotsubaShaderTargets>Vulkan;Metal</YotsubaShaderTargets>
    Valores: Vulkan, D3D12, Metal, WebGPU, OpenGL. Vacío = todas.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="YotsubaShaderTargets" />
  </ItemGroup>
</Project>
