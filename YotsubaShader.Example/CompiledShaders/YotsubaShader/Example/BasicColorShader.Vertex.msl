#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct VS_Output
{
    float4 Position;
    float4 Color;
};

struct VS_out
{
    float4 _return_Color [[user(locn8)]];
    float4 gl_Position [[position]];
};

struct VS_in
{
    float2 input_Position [[attribute(0)]];
    float4 input_Color [[attribute(8)]];
};

static inline __attribute__((always_inline))
float4 NewVector4(float x, float y, float z)
{
    float4 _this;
    _this.x = x;
    _this.y = y;
    _this.z = z;
    _this.w = float(1);
    return _this;
}

vertex VS_out VS(VS_in in [[stage_in]])
{
    VS_out out = {};
    VS_Output _output;
    _output.Position = NewVector4(in.input_Position.x, in.input_Position.y, 2.0);
    _output.Color = in.input_Color;
    out.gl_Position = _output.Position;
    out._return_Color = _output.Color;
    return out;
}

