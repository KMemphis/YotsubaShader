#version 310 es
#extension GL_EXT_shader_io_blocks : require
precision mediump float;
precision highp int;

struct _25
{
    highp vec4 _m0;
    highp vec4 _m1;
};

in FS_Input
{
    layout(location = 8) highp vec4 Color;
} _input;

out highp vec4 _return;

void main()
{
    _return = _input.Color;
}

