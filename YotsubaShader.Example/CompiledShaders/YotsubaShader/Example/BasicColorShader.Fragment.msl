#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct VS_Input
{
    float2 Position;
    float4 Color;
};

struct FS_Input
{
    float4 Color;
};

struct _24
{
    float4 _m0;
    float4 _m1;
};

struct FS_out
{
    float4 _return;
};

struct FS_in
{
    float4 _input_Color [[user(locn8)]];
};

fragment FS_out FS(FS_in in [[stage_in]])
{
    FS_out out = {};
    FS_Input _input = {};
    _input.Color = in._input_Color;
    out._return = _input.Color;
    return out;
}

