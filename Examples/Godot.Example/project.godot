; Engine configuration file.
config_version=5

[application]

config/name="YotsubaShader Godot Example"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4")

[editor_plugins]

enabled=PackedStringArray("res://addons/yotsubashader/plugin.cfg")

[yotsuba_shader]

project="Shaders/Godot.Shaders.csproj"
output_dir="res://yotsuba_shaders"
shader_type="spatial"
