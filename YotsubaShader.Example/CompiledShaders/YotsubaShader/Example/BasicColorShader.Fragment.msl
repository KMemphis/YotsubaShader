#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct VS_Output
{
    float4 Position;
    float4 Color;
};

struct FS_out
{
    float4 _return [[color(0)]];
};

struct FS_in
{
    float4 input_Color [[user(locn8)]];
};

fragment FS_out FS(FS_in in [[stage_in]])
{
    FS_out out = {};
    out._return = in.input_Color;
    return out;
}

