<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>yotsuba</ToolCommandName>
        <PackageId>YotsubaShader.Compiler.CLI</PackageId>
        <Description>YotsubaShader command-line compiler for C# shader projects.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\YotsubaShader.Compiler.Library\YotsubaShader.Compiler.Library.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\ThirdParty\ShadowDusk\src\ShadowDusk.HLSL\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="tools/net10.0/any/THIRD-PARTY-NOTICES.txt" Visible="false" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="tools/net10.0/any/" Visible="false" />
        <None Include="..\ShaderCross\YotsubaShaderCross\LICENSE" Pack="true" PackagePath="tools/net10.0/any/YotsubaShaderCross/" Visible="false" />
    </ItemGroup>
    <!-- Bibliotecas nativas de naga (SPIR-V -> WGSL), una por RID: las genera Native/naga/build.sh o el workflow naga-native.yml. -->
    <ItemGroup>
        <None Include="Native\naga\runtimes\**\*" Pack="true" PackagePath="tools/net10.0/any/runtimes/" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />

        <PackageReference Include="Microsoft.Build.Framework"
                          Version="17.11.48"
                          ExcludeAssets="runtime"
                          PrivateAssets="all" />

        <!-- YotsubaShader.CLI.csproj: permanece net10.0 -->
            <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
            <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
            <!-- Completado y ayuda al pasar el ratón del servidor de lenguaje (yotsuba lsp) -->
            <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.0.0" />
    </ItemGroup>
</Project>
