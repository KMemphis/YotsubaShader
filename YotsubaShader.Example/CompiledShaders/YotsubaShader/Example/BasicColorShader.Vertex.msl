#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct VS_Output
{
    float4 Position;
    float4 Color;
};

struct VS_out
{
    float4 _return_Color [[user(locn8)]];
    float4 gl_Position [[position]];
};

struct VS_in
{
    float2 input_Position [[attribute(0)]];
    float4 input_Color [[attribute(8)]];
};

vertex VS_out VS(VS_in in [[stage_in]])
{
    VS_out out = {};
    VS_Output _output;
    _output.Position = float4(in.input_Position.x, in.input_Position.y, 0.0, 1.0);
    _output.Color = in.input_Color;
    out.gl_Position = _output.Position;
    out._return_Color = _output.Color;
    return out;
}

