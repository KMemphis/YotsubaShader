<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\YotsubaShader.Roslyn\YotsubaShader.Roslyn.csproj" />
      <ProjectReference Include="..\YotsubaShader.Language\YotsubaShader.Language.csproj" />
      <ProjectReference Include="..\YotsubaShader.HlslSyntax\YotsubaShader.HlslSyntax.csproj" />
      <ProjectReference Include="..\YotsubaShader.SpirvSyntax\YotsubaShader.SpirvSyntax.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <CompileYotsubaShaders>true</CompileYotsubaShaders>
        <YotsubaCliProject>$(MSBuildThisFileDirectory)../YotsubaShader.CLI/YotsubaShader.CLI.csproj</YotsubaCliProject>
        <YotsubaShaderOutput>$(MSBuildProjectDirectory)/CompiledShaders</YotsubaShaderOutput>
    </PropertyGroup>

    <Target Name="CompileYotsubaShaders"
            AfterTargets="Build"
            Condition="'$(CompileYotsubaShaders)' == 'true'
                   And '$(DesignTimeBuild)' != 'true'">
        <Exec Command="dotnet run --project &quot;$(YotsubaCliProject)&quot; -- add &quot;$(MSBuildProjectFullPath)&quot; --target spirv --target hlsl --target glsl --target gles --target msl --target cpp --output &quot;$(YotsubaShaderOutput)&quot;" />
    </Target>

</Project>
