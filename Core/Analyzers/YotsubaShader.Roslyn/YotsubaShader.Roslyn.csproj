<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- Los descriptores de YotsubaShader.Rules se publican en el analizador del IDE, no aquí. -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ICSharpCode.Decompiler" Version="11.2.0.10050" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    </ItemGroup>

    <!-- Código C# que se añade a la compilación del shader (Math sin instrucción de GPU). No es parte de esta DLL. -->
    <ItemGroup>
        <Compile Remove="Polyfills\**\*.cs" />
        <EmbeddedResource Include="Polyfills\**\*.cs" LogicalName="YotsubaShader.Polyfills.%(Filename).cs" />
    </ItemGroup>

    <!-- Las mismas reglas que el analizador del IDE (YotsubaShader.IDE.Analyzer). -->
    <ItemGroup>
        <Compile Include="..\YotsubaShader.Rules\**\*.cs" LinkBase="Rules" />
        <Compile Include="..\YotsubaShader.IDE.Analyzer\GraphicsApi\**\*.cs" LinkBase="Rules\GraphicsApi" />
        <Compile Include="..\..\Syntax\YotsubaShader.Compiler.Metadata\Target.cs" LinkBase="Rules\Metadata" />
        <Compile Include="..\..\Syntax\YotsubaShader.Compiler.Metadata\GameEngine.cs" LinkBase="Rules\Metadata" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Syntax\YotsubaShader.Concepts\YotsubaShader.Concepts.csproj" />
        <ProjectReference Include="..\..\Representations\YotsubaShader.IR\YotsubaShader.IR.csproj" />
        <ProjectReference Include="..\..\Representations\YotsubaShader.Language\YotsubaShader.Language.csproj" />
    </ItemGroup>

</Project>